{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": {"api/index.ts": {"maxDuration": 60}},
  "rewrites": [
    {"source": "/api/auth/login", "destination": "/api"},
    {"source": "/.well-known/auth", "destination": "/api"},
    {"source": "/api/:path*", "destination": "/api"},
    {"source": "/((?!assets/|.*\\.[^/]+$).*)", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source": "/(attendee-offline-worker|offline-worker|scanner-offline-worker).js", "headers": [{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source": "/index.html", "headers": [{"key":"Cache-Control","value":"no-cache"}]}
  ],
  "crons": [{"path":"/api/internal/headers/collect","schedule":"0 5 * * *"}]
}
